<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The PointerPath AutoCAD add-in: the same source as the BricsCAD add-in
    (src/PointerPath.BricsCAD), compiled against the AutoCAD .NET API with AUTOCAD defined.

      dotnet build -c Release

    builds both flavours:
      net48            AutoCAD 2021 to 2024 (R24.0 to R24.3), .NET Framework 4.8
      net8.0-windows   AutoCAD 2025 and later (R25.0+), .NET 8

    The AutoCAD API comes from Autodesk's AutoCAD.NET NuGet package, so AutoCAD doesn't have
    to be installed to build (and it builds on any OS). Each flavour is compiled against the
    oldest release it supports; AutoCAD keeps its .NET API compatible within a major series.
  -->

  <PropertyGroup>
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>PointerPath.BricsCAD</RootNamespace>
    <AssemblyName>PointerPath.AutoCAD</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <DefineConstants>$(DefineConstants);AUTOCAD</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Copy NuGet dependencies (System.Text.Json on .NET Framework) next to the add-in DLL. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF image types are needed for the ribbon button icons. -->
    <UseWPF>true</UseWPF>
    <!-- Plugin-style output: a .deps.json next to the DLL so dependencies resolve. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <!-- AutoCAD's own assemblies are referenced, never shipped: AutoCAD supplies them. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="AutoCAD.NET" Version="24.0.0" ExcludeAssets="runtime" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <!-- WPF image types for the ribbon button icons. -->
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <PackageReference Include="AutoCAD.NET" Version="25.0.1" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PointerPath.Core\PointerPath.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\PointerPath.BricsCAD\*.cs" Link="%(Filename)%(Extension)" />
    <None Include="..\PointerPath.BricsCAD\turn-paths.json" Link="turn-paths.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Ribbon icons, under the names the shared source loads them by. -->
    <EmbeddedResource Include="..\PointerPath.BricsCAD\Resources\*.png" LogicalName="PointerPath.BricsCAD.Resources.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
