# Copy to .env for local development (`node --env-file=.env src/server.js`).
# On Render these are set in the service's Environment page; render.yaml lists them.

# Required
DATABASE_URL=postgres://postgres@localhost:5432/pointerpath
SESSION_SECRET=change-me
# From `npm run licence-key`. Required in production; a throwaway key is used without it.
LICENCE_SIGNING_KEY=

# The site's public address, used in emails and Stripe return links.
# On Render this defaults to the service's onrender.com address; set it once you have a domain.
BASE_URL=http://localhost:3000

# Stripe. Leave blank to run the site with buying switched off.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The Price of the licence product. A one-off price sells a licence that doesn't expire;
# a recurring price sells a subscription. The site shows whatever this price says.
STRIPE_PRICE_ID=
# Set to 1 to have Stripe Tax work out GST at checkout (Stripe Tax must be set up first).
STRIPE_AUTOMATIC_TAX=

# Resend. Leave blank to have emails printed in the log instead of sent.
RESEND_API_KEY=
EMAIL_FROM=PointerPath <hello@example.com>

# Plausible. Set one: the script address from Plausible's "Site installation" page,
# or (older snippet) just the site's domain.
PLAUSIBLE_SCRIPT_URL=
PLAUSIBLE_DOMAIN=

# Where the installer is hosted (any address a browser can download from) and its version.
INSTALLER_URL=
INSTALLER_VERSION=

# Restrict PointerPath to some countries: two-letter codes, comma-separated (e.g. AU).
# Signing up, buying, downloading and activating are then refused from anywhere else.
# Leave blank for no restriction (local addresses have no country, so set it only when deployed).
ALLOWED_COUNTRIES=
# How the visitor's real IP address reaches the app. See "Restricting to a country" in README.md.
# On Render: CLIENT_IP_HEADER=cf-connecting-ip and TRUST_PROXY_HOPS=2 (set in render.yaml).
CLIENT_IP_HEADER=
TRUST_PROXY_HOPS=1
GEO_DEBUG=

# Licensing
LICENCE_MAX_MACHINES=2
LICENCE_TOKEN_DAYS=14
