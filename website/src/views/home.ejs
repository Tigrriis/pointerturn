<%- include('partials/head') %>
<section class="wrap hero">
<div class="hero__text">
<h1>Easy and accurate <span class="mark">swept paths</span> inside your CAD software.</h1>
<p class="lead">PointerPath is a simple, lightweight vehicle swept path analysis add-in for BricsCAD and AutoCAD. Perfect for residential and small commercial civil and traffic engineering.</p>
<div class="actions">
<% if (!region.blocked) { %><a class="button" href="/buy">Buy a licence</a><% } %>
<a class="text-link" href="#vehicles">See the vehicles</a>
</div>
</div>
<div class="hero__art">
<figure class="sheet">
<%- include('partials/sweep') %>
<figcaption class="sheet__block">
<div><span class="label">Vehicle</span><span>8.8 m MRV</span></div>
<div><span class="label">Radius</span><span>10 m</span></div>
<div><span class="label">Units</span><span>Metres</span></div>
</figcaption>
</figure>
</div>
</section>

<%# The feature tiles (Solve turn, In and out, Conflicts, Editable paths) are switched off for now.
    To bring them back: include('partials/features') here, and restore the Features links in the header and footer. %>

<section id="vehicles" class="band">
<div class="wrap band__inner">
<h2>From a B85 car to a 12.5 m HRV</h2>
<ul class="chips">
<li>B85 car</li>
<li>B99 car</li>
<li>6.4 m SRV</li>
<li>8.8 m MRV</li>
<li>12.5 m HRV</li>
<li>8.8 m service vehicle</li>
<li>12.5 m truck</li>
</ul>
<p>Cars to AS/NZS 2890.1. Rigid trucks to AS 2890.2 and from the Austroads design vehicle guide. Works in metres or millimetres.</p>
</div>
</section>

<% if (!region.blocked) { %>
<section id="buy" class="wrap buy">
<div class="buy__panel">
<div class="buy__text">
<h2>Beta version pricing</h2>
<p>Reduced pricing for the beta version of PointerPath. Install and sign in within the add-in to activate the software.</p>
<% if (region.restricted) { %><p>For use in <%= region.where %> only.</p><% } %>
</div>
<div class="buy__price">
<% if (price) { %>
<p class="price"><span class="price__amount"><%= price.amount %></span> <span class="price__unit"><% if (price.recurring) { %>per <%= price.interval %> <% } %>for <%= seats %></span></p>
<p class="price__note"><%= [price.currency, price.tax].filter(Boolean).join(', ') %></p>
<% if (price.full) { %><p class="price__full">Final release price <%= price.full %></p><% } %>
<% } %>
<a class="button button--accent" href="/buy">Buy a licence</a>
</div>
</div>
</section>
<% } %>
<%- include('partials/foot') %>
